# Copy to .env.local for local work; set the same names in your hosting dashboard for production.
# Never commit real values.

# --- Admin area (/admin) ---
# Username for the /admin pages (HTTP Basic login).
ADMIN_USER=
# Password for the /admin pages. In production, /admin returns 404 until both are set.
ADMIN_PASSWORD=

# --- Shopify checkout (leave all blank until the Shopify store exists) ---
# Your store's permanent address, e.g. your-store.myshopify.com (no https://).
SHOPIFY_STORE_DOMAIN=
# Storefront API access token (Headless / Storefront API app). Server-side only; never prefix with NEXT_PUBLIC.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Storefront API version, e.g. 2025-07. The built-in default is only a placeholder: set this to Shopify's
# current stable version when the store is created, and revisit it every few months (see docs/SHOPIFY_SETUP.md).
SHOPIFY_API_VERSION=
# Set to 1 to show the "Checkout securely" button in the cart. Any other value keeps WhatsApp-only checkout.
NEXT_PUBLIC_SHOPIFY_CHECKOUT=

# --- Vendor marketplace (docs/VENDOR_PORTAL.md) ---
# Postgres connection string. Required in production. Leave blank in development to use the
# embedded database in .data/pglite.
DATABASE_URL=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts sellers' bank account and PAN.
# Required in production. Keep it safe: losing it makes stored bank details unreadable.
VENDOR_DATA_KEY=

# --- One-time codes (customer and rider sign-in, seller sign-up checks) ---
# In development codes are printed in the server console. In production a channel works once its
# provider's keys are set (same names as the old riderzpro.com site; src/lib/server/otp.ts).
# Email (Resend): API key and a verified sender, e.g. Riderzpro <codes@riderzpro.com>.
RESEND_API_KEY=
# The sender. RESEND_FROM (the old site's name) also works.
OTP_EMAIL_FROM=
# SMS: MSG91 (needs a DLT-approved OTP template with an ##OTP## variable) or Twilio.
# Only needed when keys for both are set: "msg91" or "twilio".
OTP_SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Razorpay (payments; rider and seller payouts later) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
