# Copy to .env.local for local work; set the same names in your hosting dashboard for production.
# Never commit real values.

# --- Admin area (/admin) ---
# Username for the /admin pages (HTTP Basic login).
ADMIN_USER=
# Password for the /admin pages. In production, /admin returns 404 until both are set.
ADMIN_PASSWORD=

# --- Shopify checkout (leave all blank until the Shopify store exists) ---
# Your store's permanent address, e.g. your-store.myshopify.com (no https://).
SHOPIFY_STORE_DOMAIN=
# Storefront API access token (Headless / Storefront API app). Server-side only; never prefix with NEXT_PUBLIC.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Storefront API version, e.g. 2025-07. The built-in default is only a placeholder: set this to Shopify's
# current stable version when the store is created, and revisit it every few months (see docs/SHOPIFY_SETUP.md).
SHOPIFY_API_VERSION=
# Set to 1 to show the "Checkout securely" button in the cart. Any other value keeps WhatsApp-only checkout.
NEXT_PUBLIC_SHOPIFY_CHECKOUT=

# --- Vendor marketplace (docs/VENDOR_PORTAL.md) ---
# Postgres connection string. Required in production. Leave blank in development to use the
# embedded database in .data/pglite.
DATABASE_URL=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts sellers' bank account and PAN.
# Required in production. Keep it safe: losing it makes stored bank details unreadable.
VENDOR_DATA_KEY=

# --- One-time codes (customer and rider sign-in, seller sign-up checks) ---
# In development codes are printed in the server console. In production a channel works once its
# provider's keys are set (same names as the old riderzpro.com site; src/lib/server/otp.ts).
# Email (Resend): API key and a verified sender, e.g. Riderzpro <codes@riderzpro.com>.
RESEND_API_KEY=
# The sender. RESEND_FROM (the old site's name) also works.
OTP_EMAIL_FROM=
# SMS: MSG91 (needs a DLT-approved OTP template with an ##OTP## variable) or Twilio.
# Only needed when keys for both are set: "msg91" or "twilio".
OTP_SMS_PROVIDER=
# Development only: "true" sends real codes on channels whose keys are set (otherwise the console).
OTP_SEND_IN_DEV=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Order emails and SMS (src/lib/server/messaging.ts, order-emails.ts) ---
# Sender for order confirmation emails, e.g. Riderzpro Orders <orders@riderzpro.com>. Falls back to
# OTP_EMAIL_FROM, then RESEND_FROM.
ORDERS_EMAIL_FROM=
# Base for links in emails and SMS. Optional; defaults to https://riderzpro.com.
NEXT_PUBLIC_SITE_URL=
# MSG91 DLT template ids (flow variables named var1, var2 … in template order). Without one, that SMS
# is skipped. Twilio needs none.
MSG91_TEMPLATE_ORDER_CONFIRMED=
MSG91_TEMPLATE_RIDER_ARRIVING=
MSG91_TEMPLATE_RIDER_ARRIVED=
MSG91_TEMPLATE_RIDER_OFFER=

# --- Razorpay online payments (src/lib/server/payments.ts) ---
# Test keys start rzp_test_; live keys only in the hosting dashboard. Without them, "Pay online" is
# shown as unavailable and WhatsApp ordering still works.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret typed when adding the webhook https://riderzpro.com/api/payments/razorpay/webhook
# (events: payment.captured, payment.failed, order.paid, refund.created, refund.processed, refund.failed).
RAZORPAY_WEBHOOK_SECRET=
# Tests only (scripts/test-payments.mjs): a mock Razorpay API. Ignored in production.
RAZORPAY_API_BASE=

# --- Live tracking maps (src/lib/server/tracking-geo.ts); both optional, free defaults ---
# Map tiles, default https://tile.openstreetmap.org/{z}/{x}/{y}.png (light use only; see docs/team/Viswanath_work.md).
NEXT_PUBLIC_MAP_TILES_URL=
# Road routes and ETA, default https://router.project-osrm.org (demo server, light use only).
ROUTING_BASE_URL=
