# Copy to .env.local for local work; set the same names in your hosting dashboard for production.
# Never commit real values.

# --- Admin area (/admin) ---
# Username for the /admin pages (HTTP Basic login).
ADMIN_USER=
# Password for the /admin pages. In production, /admin returns 404 until both are set.
ADMIN_PASSWORD=

# --- Shopify checkout (leave all blank until the Shopify store exists) ---
# Your store's permanent address, e.g. your-store.myshopify.com (no https://).
SHOPIFY_STORE_DOMAIN=
# Storefront API access token (Headless / Storefront API app). Server-side only; never prefix with NEXT_PUBLIC.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Storefront API version, e.g. 2025-07. The built-in default is only a placeholder: set this to Shopify's
# current stable version when the store is created, and revisit it every few months (see docs/SHOPIFY_SETUP.md).
SHOPIFY_API_VERSION=
# Set to 1 to show the "Checkout securely" button in the cart. Any other value keeps WhatsApp-only checkout.
NEXT_PUBLIC_SHOPIFY_CHECKOUT=
